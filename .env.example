# PostHog analytics (https://us.posthog.com)
VITE_POSTHOG_KEY=phx_...
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Email Configuration
# Admin email(s) where booking notifications will be sent.
# A comma-separated list is supported: "first@example.com, second@example.com".
# The first address is used as the reply-to on customer emails.
ADMIN_EMAIL=shishachauffeurs@gmail.com

# For Gmail, you'll need to:
# 1. Enable 2-factor authentication
# 2. Generate an app password: https://support.google.com/accounts/answer/185833
# 3. Use your Gmail and the app password below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-gmail@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
EMAIL_FROM=your-sending-gmail@gmail.com
EMAIL_FROM_NAME="Shisha Chauffeurs"

# Optional: set to "true" to expose POST /api/test-email, which sends one test
# booking notification to ADMIN_EMAIL. Leave unset in normal operation.
# ENABLE_TEST_EMAIL=true

# Alternative SMTP providers:
# For Outlook/Hotmail:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587

# For Yahoo:
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=587

# For custom SMTP:
# SMTP_HOST=your-smtp-server.com
# SMTP_PORT=587
